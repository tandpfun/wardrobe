OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high

# Add a PNG at data/model-reference.png or point to another local file.
WARDROBE_MODEL_REFERENCE=data/model-reference.png

# Image-to-image backend for the garment and modeled stages: openai (default) or minimax.
WARDROBE_IMAGE_PROVIDER=openai
# Required when WARDROBE_IMAGE_PROVIDER=minimax.
MINIMAX_API_KEY=
# Global endpoint by default; use https://api.minimaxi.com/v1 for the China endpoint.
MINIMAX_API_BASE_URL=https://api.minimax.io/v1
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_IMAGE_RESPONSE_FORMAT=base64
